# IN4 Solutions static site — optional environment configuration
# Copy to a real environment file as needed. Nothing is required to run locally.

# When set, the lead form POSTs submissions to this endpoint (e.g. a Zoho CRM
# webhook or your own API `/api/leads`). If left blank, the form runs in
# development mode and shows a clear "not configured" warning instead of
# pretending a submission succeeded.
LEAD_WEBHOOK_URL=

# Optional email address to notify on new leads (depends on your backend).
LEAD_NOTIFICATION_EMAIL=

# Canonical public site URL used for metadata and links.
NEXT_PUBLIC_SITE_URL=https://www.in4solution.com